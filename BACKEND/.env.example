# Application Configuration
APP_NAME="Family Health Guardian API"
DEBUG=True
API_V1_STR="/api/v1"

# Supabase Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
# Service-role key — backend only; NEVER expose to frontend or mobile clients!
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-min-32-chars"

# Supabase Storage bucket name for health record files (default: medical-reports)
HEALTH_RECORDS_BUCKET="medical-reports"

# Optional ML Model Path Overrides (Defaults to project models/ directory if omitted)
# DIABETES_MODEL_PATH="models/diabetes_model.pkl"
# HYPERTENSION_MODEL_PATH="models/hypertension_model.pkl"

