# ========================================================
# Family Health Guardian - Environment Configuration
# ========================================================

# FastAPI Backend API Base URL (including API version prefix)
# Default local development server: http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=https://family-health-guardian-backend.onrender.com/api/v1

# Supabase Project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Client Key (Public Anon Key)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
